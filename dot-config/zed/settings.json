// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "ssh_connections": [
    {
      "host": "nova",
      "args": [],
      "projects": [
        {
          "paths": ["/home/vaskel"]
        },
        {
          "paths": ["/home/vaskel/website-svelte"]
        }
      ]
    }
  ],
  "disable_ai": true,
  "inlay_hints": {
    "enabled": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
    "toggle_relative_line_numbers": true
  },
  "base_keymap": "VSCode",
  "theme": "Gruvbox Material",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "language_overrides": {
    "Python": {
      "format_on_save": {
        "external": {
          "command": "ruff",
          "arguments": [
            "check",
            "--exit-zero",
            "--fix",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    }
  },
  "terminal": {
    "detect_venv": {
      "on": {
        "activate_script": "fish"
      }
    }
  }
}
