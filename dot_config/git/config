[alias]
	ac = "! ac() { [ -z $1 ] && echo 'ac: error: file argument required' && exit 1 || git add $@ && git commit; }; ac"
	acp = "! acp() { [ -z $1 ] && echo 'acp: error: file argument required' && exit 1 || git ac $@ && git push; }; acp"

[color]
	ui = "auto"

[core]
	autoclrf = false
	ignorecase = true
	pager = "/nix/store/84mrcjwm7kghj0i46lyic7mww1avc4y9-delta-0.18.2/bin/delta"

[delta]
	navigate = true

[diff]
	colorMoved = "default"

[help]
	autocorrect = 20

[init]
	defaultBranch = "main"

[interactive]
	diffFilter = "/nix/store/84mrcjwm7kghj0i46lyic7mww1avc4y9-delta-0.18.2/bin/delta --color-only"

[merge]
	conflictstyle = "diff3"

[pull]
	ff = "only"

[push]
	autoSetupRemote = true
	default = "current"
	followTags = true

[url "git@github.com:"]
	insteadOf = "gh:"
	pushInsteadOf = "https://github.com"

[user]
	email = "49348256+ImVaskel@users.noreply.github.com"
	name = "ImVaskel"

[include]
	path = "~/.config/git/config.local"
